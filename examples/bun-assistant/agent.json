{
  "allowAnyPlaybook": true,
  "allowedPlaybookRefs": [],
  "capabilityPolicy": {
    "policyRef": {
      "resourceId": {
        "urn": "urn:vam:policy:local.vam.dev/vam/assistant-egress-only"
      }
    },
    "securityProfileName": "assistant-profile"
  },
  "contextPolicy": {
    "compaction": "COMPACTION_POLICY_SUMMARIZE_MIDDLE",
    "maxHistoryTurns": 30,
    "maxTokenCount": 96000
  },
  "description": "An autonomous agent designed to run inside a VAM microVM and perform safe calculations using Bun, with filesystem and todo tools provided by runtime primitives.",
  "displayName": "Bun Assistant Agent",
  "hitlPolicy": {
    "monitoredTools": [],
    "policyRef": {
      "resourceId": {
        "urn": "urn:vam:policy:local.vam.dev/vam/high-risk-assistant-actions"
      }
    }
  },
  "metadata": {
    "createdBy": {
      "urn": "urn:vam:user:local.vam.dev/vam/admin"
    },
    "labels": [
      {
        "key": "environment",
        "value": "production"
      }
    ],
    "revision": 1
  },
  "modelRequirements": {
    "minContextTokens": 128000,
    "requiredModalities": [
      "text"
    ],
    "requiresStructuredOutput": true,
    "requiresToolCalling": true
  },
  "preferredModels": [
    {
      "maxCompletionTokens": 4096,
      "modelName": "openai/gpt-4o-mini",
      "provider": "openrouter",
      "temperature": 0.1
    }
  ],
  "reasoningPolicy": {
    "maxIterations": 10,
    "stepTimeout": "300s",
    "termination": "TERMINATION_POLICY_EXPLICIT_CLAIM"
  },
  "resourceId": {
    "urn": "urn:vam:agent:local.vam.dev/vam/bun-assistant"
  },
  "resourceRequirements": {
    "memoryMib": 2048,
    "networkMode": "NETWORK_MODE_RESTRICTED_EGRESS",
    "storageGib": 10,
    "vcpuCount": 2
  },
  "role": "Bun Assistant",
  "skillRefs": [
    {
      "resourceId": {
        "urn": "urn:vam:skill:local.vam.dev/vam/assistant-tools"
      }
    }
  ],
  "systemInstructions": "Your baseline mission is to help the user with computations and workspace tasks inside their secure VM. Call load_skill with catalog id assistant-tools before using the calculator skill tool. Use runtime primitives (read_file, write_file, edit_file, glob, grep, run, todo_write) for files, search, shell commands, and todos. Do not call write_note or list_workspace \u2014 those legacy skill tools were removed in M1.",
  "telemetryPolicy": {
    "auditLedgerMode": "AUDIT_LEDGER_MODE_HASH_CHAINED",
    "piiRedactionEnabled": true,
    "policyRef": {
      "resourceId": {
        "urn": "urn:vam:policy:local.vam.dev/vam/standard-telemetry-compliance"
      }
    }
  }
}
