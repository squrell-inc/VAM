{
  "urn": "urn:vam:connector:{{domain}}/community/{{id}}",
  "version": "1.0.0",
  "displayName": "{{name}}",
  "publisher": "{{domain}}",
  "description": "{{description}}",
  "icon": "{{icon}}",
