{
  "urn": "urn:vam:connector:{{domain}}/community/{{id}}",
  "version": "1.0.0",
  "displayName": "{{name}}",
  "publisher": "{{domain}}",
  "description": "{{description}}",
  "icon": "{{icon}}",
  "provider": {
    "kind": "api_key",
    "fields": [
      {
        "name": "key",
        "label": "{{name}} API key"
      }
    ]
  },
  {{tenant}}"connection": {
    "holder": "user",
    "multiAccount": false,
    "label": "none"
  },
  "bindings": [
    {
      "name": "api",
      "placeholder": "vamsec_{{id}}_api",
      "value": "api_key",
      "inject": "bearer",
      "hosts": [
        "{{host}}"
      ]
    }
  ]
}
