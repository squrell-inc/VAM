{
  "urn": "urn:vam:connector:hub.squrell.cloud/squrell/linear",
  "version": "1.0.0",
  "displayName": "Linear",
  "publisher": "Squrell",
  "description": "Issues and comments in the member's own Linear workspace, through Linear's remote MCP server.",
  "icon": "linear",
  "provider": {
    "kind": "oauth2",
    "profile": "discover",
    "clientSecret": "none",
    "scopes": ["read", "write"],
    "orgConsent": "none"
  },
  "connection": { "holder": "user", "multiAccount": false, "label": "whoami.email" },
  "mcp": {
    "url": "https://mcp.linear.app/mcp",
    "tools": [
      { "remote": "list_issues", "sideEffect": "READ_ONLY" },
      { "remote": "get_issue", "sideEffect": "READ_ONLY" },
      { "remote": "save_issue", "sideEffect": "MUTABLE_EXTERNAL", "default": "ask" },
      { "remote": "save_comment", "sideEffect": "MUTABLE_EXTERNAL", "default": "ask" }
    ]
  }
}
