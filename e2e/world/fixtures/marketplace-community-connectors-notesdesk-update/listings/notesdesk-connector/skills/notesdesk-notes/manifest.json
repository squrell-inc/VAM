{
  "resourceId": {
    "urn": "urn:vam:skill:connectors.community.example/community/notesdesk-notes"
  },
  "version": {
    "major": 1,
    "minor": 1,
    "patch": 0
  },
  "description": "Search the member's Notesdesk notes; create one only with the member's approval",
  "requiresConnector": "urn:vam:connector:connectors.community.example/community/notesdesk",
  "tools": [
    {
      "name": "note_search",
      "description": "Searches notes (GET /v1/notes)",
      "inputSchemaJson": "{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\"},\"title\":{\"type\":\"string\"},\"host\":{\"type\":\"string\"},\"path\":{\"type\":\"string\"}}}",
      "sideEffect": "SIDE_EFFECT_CLASS_READ_ONLY",
      "localExec": {
        "command": "python3",
        "entrypoint": "./notes.py"
      },
      "egress": [
        {
          "binding": "api",
          "host": "api.notesdesk.example",
          "methods": [
            "GET"
          ],
          "pathPrefixes": [
            "/v1/notes"
          ]
        },
        {
          "binding": "api",
          "host": "eu.api.notesdesk.example",
          "methods": [
            "GET"
          ],
          "pathPrefixes": [
            "/v1/notes"
          ]
        }
      ]
    },
    {
      "name": "note_create",
      "description": "Creates a note (POST /v1/notes); asks the member first",
      "inputSchemaJson": "{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\"},\"title\":{\"type\":\"string\"},\"host\":{\"type\":\"string\"},\"path\":{\"type\":\"string\"}}}",
      "sideEffect": "SIDE_EFFECT_CLASS_MUTABLE_EXTERNAL",
      "localExec": {
        "command": "python3",
        "entrypoint": "./notes.py"
      },
      "egress": [
        {
          "binding": "api",
          "host": "api.notesdesk.example",
          "methods": [
            "POST"
          ],
          "paths": [
            "/v1/notes"
          ]
        },
        {
          "binding": "api",
          "host": "eu.api.notesdesk.example",
          "methods": [
            "POST"
          ],
          "paths": [
            "/v1/notes"
          ]
        }
      ],
      "approvalRequired": true
    }
  ]
}
