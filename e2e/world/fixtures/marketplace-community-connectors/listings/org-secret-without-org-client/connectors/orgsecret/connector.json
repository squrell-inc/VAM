{
  "urn": "urn:vam:connector:connectors.community.example/community/orgsecret",
  "version": "1.0.0",
  "displayName": "Orgsecret",
  "publisher": "Community Tools Ltd",
  "description": "Orgsecret files in the member's own account, through its remote MCP server.",
  "icon": "orgsecret",
  "provider": {
    "kind": "oauth2",
    "profile": "discover",
    "clientSecret": "org_vault",
    "scopes": [
      "read"
    ],
    "orgConsent": "none"
  },
  "connection": {
    "holder": "user",
    "multiAccount": false,
    "label": "whoami.email"
  },
  "mcp": {
    "url": "https://mcp.orgsecret.example/mcp",
    "tools": [
      {
        "remote": "search_files",
        "sideEffect": "READ_ONLY"
      },
      {
        "remote": "read_file",
        "sideEffect": "READ_ONLY"
      }
    ]
  }
}
