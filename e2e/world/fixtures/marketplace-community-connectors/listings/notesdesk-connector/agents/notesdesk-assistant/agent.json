{
  "spec": {
    "resourceId": {
      "urn": "urn:vam:agent:connectors.community.example/community/notesdesk-assistant"
    },
    "displayName": "Notesdesk assistant",
    "description": "Finds the member's Notesdesk notes; creates one only after the member approves.",
    "role": "Notes assistant",
    "systemInstructions": "Load the notesdesk-notes skill before using its tools. Read freely; never create a note without approval. Be brief and finish with task_complete.",
    "allowAnyPlaybook": true,
    "skillRefs": [
      {
        "resourceId": {
          "urn": "urn:vam:skill:connectors.community.example/community/notesdesk-notes"
        },
        "version": {
          "major": 1,
          "minor": 0,
          "patch": 0
        }
      }
    ],
    "permissions": {
      "tools": {
        "default": "deny",
        "rules": [
          {
            "target": "builtin:load_skill",
            "decision": "allow"
          },
          {
            "target": "skill:notesdesk-notes/note_search",
            "decision": "allow"
          },
          {
            "target": "skill:notesdesk-notes/note_create",
            "decision": "ask"
          }
        ]
      }
    }
  }
}
